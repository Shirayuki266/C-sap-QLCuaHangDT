@model OrderDto
@{ViewData["Title"]="Chi tiết đơn hàng";}
<a asp-action="Index">← Lịch sử đơn hàng</a><h1 class="mt-3">Đơn @Model.Code</h1><p><strong>@Labels.Status(Model.Status)</strong> · @Labels.Status(Model.Payment)</p><section class="product"><h2>Thông tin nhận hàng</h2><p>@Model.Recipient · @Model.Phone<br/>@Model.Address</p><div class="table-responsive"><table class="table"><thead><tr><th>Mặt hàng</th><th>Biến thể</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.Name<br/>@line.Sku</td><td>@line.Variant</td><td>@line.Quantity</td><td>@line.Price.FormatMoney() ₫</td><td>@line.Total.FormatMoney() ₫</td></tr>}</tbody></table></div><h2>Tổng COD: @Model.Total.FormatMoney() ₫</h2>
@if(Model.Status=="CHO_XAC_NHAN"){<form asp-action="Cancel" asp-route-id="@Model.Id" method="post" data-confirm="Bạn có chắc muốn hủy đơn này?"><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="OperationKey" value="@Guid.NewGuid()"/><label>Lý do hủy<input class="form-control" name="Reason" required maxlength="500"/></label><button class="btn btn-outline-danger">Hủy đơn hàng</button></form>}</section><section class="product mt-4"><h2>Lịch sử xử lý</h2><ol>@foreach(var h in Model.History){<li><time>@Labels.Local(h.At).ToString("dd/MM/yyyy HH:mm")</time> · @Labels.Status(h.To) · @h.Actor @if(!string.IsNullOrWhiteSpace(h.Reason)){<p>@h.Reason</p>}</li>}</ol></section>

