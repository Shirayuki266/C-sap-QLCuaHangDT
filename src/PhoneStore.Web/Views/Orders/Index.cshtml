@model Page<OrderDto>
@{ViewData["Title"]="Lịch sử đơn hàng";var statuses=new[]{"CHO_XAC_NHAN","DA_XAC_NHAN","DANG_GIAO","HOAN_TAT","DA_HUY","GIAO_THAT_BAI"};}
<h1>Lịch sử đơn hàng</h1><div asp-validation-summary="All" class="text-danger" role="alert"></div><form method="get" class="filters"><label>Trạng thái<select name="status" class="form-select"><option value="">Tất cả</option>@foreach(var s in statuses){<option value="@s" selected="@(Context.Request.Query["status"]==s)">@Labels.Status(s)</option>}</select></label><label>Từ ngày<input type="date" name="from" value="@Context.Request.Query["from"]" class="form-control"/></label><label>Đến ngày<input type="date" name="to" value="@Context.Request.Query["to"]" class="form-control"/></label><button class="btn btn-primary">Lọc</button><a asp-action="Index">Xóa bộ lọc</a></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Đặt lúc</th><th>Tổng tiền</th><th>Trạng thái</th><th>COD</th><th>Thao tác</th></tr></thead><tbody>@foreach(var o in Model.Items){<tr><td>@o.Code</td><td>@Labels.Local(o.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@o.Total.FormatMoney() ₫</td><td>@Labels.Status(o.Status)</td><td>@Labels.Status(o.Payment)</td><td><a asp-action="Details" asp-route-id="@o.Id">Xem chi tiết</a></td></tr>}</tbody></table></div>@if(Model.Total==0){<p class="alert alert-info">Không có đơn phù hợp.</p>}
<nav class="pagination-links" aria-label="Phân trang">@if(Model.PageNumber>1){<a href="@Url.Action("Index",new{page=Model.PageNumber-1,status=Context.Request.Query["status"].ToString(),from=Context.Request.Query["from"].ToString(),to=Context.Request.Query["to"].ToString()})">← Trước</a>}<span>Trang @Model.PageNumber · @Model.Total đơn</span>@if(Model.PageNumber*Model.PageSize<Model.Total){<a href="@Url.Action("Index",new{page=Model.PageNumber+1,status=Context.Request.Query["status"].ToString(),from=Context.Request.Query["from"].ToString(),to=Context.Request.Query["to"].ToString()})">Sau →</a>}</nav>

