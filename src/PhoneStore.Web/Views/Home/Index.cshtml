@model List<ProductDto>
@{ViewData["Title"]="Trang chủ";var hasSales=ViewData["HasSales"] is true;}
<section class="home-banner"><div><span>PHONE STORE · ĐỒNG HÀNH CÙNG BẠN</span><h1>Chiếc điện thoại mới.<br/>Trải nghiệm mỗi ngày.</h1><p>Khám phá điện thoại theo phong cách và nhu cầu của bạn. Giá rõ ràng, lựa chọn đa dạng, thanh toán khi nhận hàng.</p><a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Xem tất cả sản phẩm →</a></div><img src="/images/phone.svg" alt="Khám phá điện thoại tại Phone Store"/></section>
<section class="home-products"><div class="section-heading"><div><h2>@(hasSales?"Sản phẩm bán chạy":"Khám phá sản phẩm")</h2><p>@(hasSales?"Những lựa chọn được khách hàng yêu thích trong 30 ngày gần nhất.":"Chưa có giao dịch hoàn tất trong kỳ. Mời bạn khám phá danh mục cửa hàng.")</p></div><a asp-controller="Catalog" asp-action="Index">Xem tất cả</a></div><partial name="_ProductCards" model="Model"/>@if(Model.Count==0){<p class="alert alert-info">Cửa hàng đang cập nhật sản phẩm. Bạn vui lòng quay lại sau.</p>}</section>
