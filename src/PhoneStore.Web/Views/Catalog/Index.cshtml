@model Page<ProductDto>
@{var searching=ViewData["Searching"] is true;ViewData["Title"]=searching?"Kết quả tìm kiếm":"Sản phẩm";var f=(CatalogFilter)ViewData["Filter"]!;var brands=(List<LookupDto>)ViewData["Brands"]!;var colors=(List<string>)ViewData["Colors"]!;var action=searching?"Search":"Index";
string Link(CatalogFilter filter)=>Url.Action(action,"Catalog",filter)!;}
<h1>@(searching?"Kết quả tìm kiếm":"Danh mục điện thoại")</h1>@if(searching){<p>Từ khóa: <strong>@(string.IsNullOrWhiteSpace(f.Query)?"Tất cả sản phẩm":f.Query)</strong></p>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<details class="filter-panel" open><summary>Bộ lọc sản phẩm</summary><form method="get" action="@(searching?"/Search":"/Catalog")" class="filters">
<label>Từ khóa<input name="Query" value="@f.Query" class="form-control" maxlength="100" placeholder="Tên, hãng, cấu hình"/></label><label>Hãng<select name="BrandId" class="form-select"><option value="">Tất cả hãng</option>@foreach(var b in brands){<option value="@b.Id" selected="@(f.BrandId==b.Id)">@b.Name</option>}</select></label>
<label>Giá từ<input type="number" name="MinPrice" min="0" step="0.01" value="@f.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control"/></label><label>Giá đến<input type="number" name="MaxPrice" min="0" step="0.01" value="@f.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control"/></label>
<label>Dung lượng<select name="StorageGb" class="form-select"><option value="">Tất cả</option>@foreach(var n in new[]{64,128,256,512,1024}){<option value="@n" selected="@(f.StorageGb==n)">@n GB</option>}</select></label>
<label>Màu sắc<select name="Color" class="form-select"><option value="">Tất cả</option>@foreach(var color in colors){<option selected="@(f.Color==color)" value="@color">@color</option>}</select></label>
<label>Sắp xếp<select name="Sort" class="form-select"><option value="">Theo tên</option><option value="price-asc" selected="@(f.Sort=="price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(f.Sort=="price-desc")">Giá giảm dần</option></select></label><button class="btn btn-primary">Áp dụng</button><a href="@(searching?"/Search":"/Catalog")">Xóa tất cả</a></form></details>
<div class="active-filters" aria-label="Bộ lọc đang áp dụng">
@if(!string.IsNullOrWhiteSpace(f.Query)){<a href="@Link(f with{Query=null,Page=1})">Từ khóa: @f.Query ×</a>}@if(f.BrandId.HasValue){<a href="@Link(f with{BrandId=null,Page=1})">Hãng: @brands.FirstOrDefault(x=>x.Id==f.BrandId)?.Name ×</a>}@if(f.MinPrice.HasValue||f.MaxPrice.HasValue){<a href="@Link(f with{MinPrice=null,MaxPrice=null,Page=1})">Khoảng giá: @f.MinPrice – @f.MaxPrice ×</a>}@if(f.StorageGb.HasValue){<a href="@Link(f with{StorageGb=null,Page=1})">@f.StorageGb GB ×</a>}@if(!string.IsNullOrWhiteSpace(f.Color)){<a href="@Link(f with{Color=null,Page=1})">Màu: @f.Color ×</a>}
</div><p>@Model.Total điện thoại · Trang @Model.PageNumber</p><partial name="_ProductCards" model="Model.Items"/>
@if(Model.Items.Count==0){<div class="alert alert-info">Không tìm thấy điện thoại. Hãy đổi tiêu chí hoặc <a href="/Catalog">xóa bộ lọc</a>.</div>}
<nav class="pagination-links" aria-label="Phân trang">@if(Model.PageNumber>1){<a href="@Link(f with{Page=Model.PageNumber-1})">← Trước</a>}@if(Model.PageNumber*Model.PageSize<Model.Total){<a href="@Link(f with{Page=Model.PageNumber+1})">Sau →</a>}</nav>
