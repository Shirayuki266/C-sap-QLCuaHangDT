@model ProductDto
@{ViewData["Title"]=Model.Name;}
<a asp-action="Index">← Danh sách điện thoại</a><article class="product detail-layout mt-4"><div class="product-gallery"><img class="detail-image" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)?"/images/phone.svg":Model.ImageUrl)" alt="@Model.Name"/><div class="gallery-thumbnails">@if(Model.Images?.Count>0){<button type="button" class="gallery-thumbnail" data-image="@Model.ImageUrl" aria-label="Xem ảnh đại diện"><img src="@Model.ImageUrl" alt="@Model.Name · ảnh đại diện" data-image-fallback="true"/></button>}@foreach(var image in Model.Images??[]){<button type="button" class="gallery-thumbnail" data-image="@image.Url" aria-label="Xem ảnh @(image.SortOrder+1)"><img src="@image.Url" alt="@Model.Name · ảnh @(image.SortOrder+1)" loading="lazy" data-image-fallback="true"/></button>}</div></div><div><small>@Model.Brand · @Model.Category</small><h1>@Model.Name</h1><p>@Model.Specifications</p><p class="description">@Model.Description</p>
@if(Model.Variants.Count>0){<form asp-controller="Cart" asp-action="Add" method="post" id="add-cart" data-guest="@(!User.IsInRole("CUSTOMER") ? "true" : "false")"><label>Chọn màu và dung lượng<select name="VariantId" id="variant" class="form-select">@foreach(var v in Model.Variants){<option value="@v.Id" data-price="@v.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-stock="@v.Available">@v.Color · @v.StorageGb GB · @v.Price.FormatMoney() ₫ · @(v.Available>0?$"Còn {v.Available}":"Hết hàng")</option>}</select></label><h2 id="variant-price" class="mt-3">@Model.Variants[0].Price.FormatMoney() ₫</h2><p id="variant-stock"></p><label>Số lượng<input class="form-control" name="Quantity" type="number" min="1" max="10000" value="1" required/></label><button class="btn btn-primary mt-3" id="add-button">Thêm vào giỏ</button><div id="add-result" role="status" aria-live="polite"></div></form>}else{<p>Không có biến thể đang bán.</p>}</div></article>

