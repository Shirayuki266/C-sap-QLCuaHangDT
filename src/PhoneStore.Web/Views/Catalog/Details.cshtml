@model PhoneStore.Web.Models.ProductDetailsViewModel
@{ ViewData["Title"] = Model.Product.Name; var product = Model.Product; var selected = Model.Selected;
    var images = new[] { product.ImageUrl }.Concat(product.Images.Select(image => image.Url)).Where(url => !string.IsNullOrWhiteSpace(url)).Distinct().ToList(); }
<nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/Catalog/Index">Điện thoại</a><span aria-hidden="true">/</span><span>@product.Name</span></nav>
<article class="product-detail" data-product-detail>
    <div class="product-gallery">
        <div class="product-main-image">
            <span class="image-placeholder" hidden="@(images.Count > 0)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 17 5-5 4 4 3-3 6 6"/><circle cx="15" cy="8" r="1"/></svg><span>Chưa có ảnh</span></span>
            @if (images.Count > 0) { <img src="@images[0]" alt="@product.Name" width="720" height="720" id="main-product-image" data-product-image /> }
        </div>
        @if (images.Count > 1) { <div class="product-thumbnails" aria-label="Ảnh sản phẩm">@foreach (var image in images) { <button type="button" data-image-url="@image" aria-label="Xem ảnh @(images.IndexOf(image) + 1) của @product.Name"><img src="@image" alt="" width="72" height="72" loading="lazy" /></button> }</div> }
    </div>
    <div class="product-buying">
        <p class="product-brand">@product.Brand</p><h1>@product.Name</h1><p class="product-spec-summary">@product.Specifications</p>
        <div class="selection-summary" aria-live="polite" aria-atomic="true"><p class="product-price" id="selected-price">@WebsiteFormatting.Money(selected.Price)</p><p>Giá áp dụng cho phiên bản đang chọn</p><p class="product-availability" id="selected-availability">@(selected.Available > 0 ? $"Còn {selected.Available} máy có thể đặt" : "Hết hàng")</p></div>
        <form method="get" action="/Catalog/Details/@product.Id" class="variant-fallback">
            <label for="variant-choice">Phiên bản</label><select name="variantId" id="variant-choice">
                @foreach (var variant in product.Variants) { <option value="@variant.Id" selected="@(variant.Id == selected.Id)" data-storage="@variant.StorageGb" data-color="@variant.Color" data-price="@WebsiteFormatting.Money(variant.Price)" data-available="@variant.Available" data-sku="@variant.Sku">@variant.StorageGb GB · @variant.Color · @WebsiteFormatting.Money(variant.Price)@(variant.Available == 0 ? " · Hết hàng" : "")</option> }
            </select><button type="submit" class="button button-secondary">Xem phiên bản</button>
        </form>
        <div class="variant-controls" hidden>
            <fieldset><legend>Dung lượng</legend><div class="variant-options">@foreach (var storage in product.Variants.Select(variant => variant.StorageGb).Distinct().Order()) { <label><input type="radio" name="storageChoice" value="@storage" checked="@(storage == selected.StorageGb)" /><span>@storage GB</span></label> }</div></fieldset>
            <fieldset><legend>Màu sắc</legend><div class="variant-options">@foreach (var color in product.Variants.Select(variant => variant.Color).Distinct()) { <label><input type="radio" name="colorChoice" value="@color" checked="@(color == selected.Color)" /><span>@color</span></label> }</div></fieldset>
        </div>
        <form method="post" action="/Cart/Add" asp-antiforgery="false" class="product-add-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@product.Id" /><input type="hidden" name="variantId" value="@selected.Id" id="selected-variant" />
            <div><label for="product-quantity">Số lượng</label><input id="product-quantity" name="quantity" type="number" min="1" max="@selected.Available" step="1" value="1" disabled="@(selected.Available == 0)" required aria-describedby="selected-availability" /></div>
            <button class="button" type="submit" disabled="@(selected.Available == 0)" id="add-to-cart">@(selected.Available == 0 ? "Hết hàng" : "Thêm vào giỏ")</button>
        </form>
        <p class="product-cod-note">Thanh toán COD khi nhận hàng. Bạn có thể xem lại thông tin trước khi đặt.</p>
    </div>
    <section class="product-information" aria-labelledby="product-info-title"><h2 id="product-info-title">Thông tin sản phẩm</h2>
        <dl><div><dt>Cấu hình</dt><dd class="catalog-preline">@product.Specifications</dd></div><div><dt>Dung lượng</dt><dd id="selected-storage">@selected.StorageGb GB</dd></div><div><dt>Màu sắc</dt><dd id="selected-color">@selected.Color</dd></div><div><dt>Mã phiên bản</dt><dd id="selected-sku">@selected.Sku</dd></div></dl>
        <h3>Mô tả</h3><p class="catalog-preline">@product.Description</p>
    </section>
</article>
