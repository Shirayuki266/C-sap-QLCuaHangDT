@model LoginRequest
@{ViewData["Title"]="Đăng nhập";}
<section class="form-card"><h1>Đăng nhập</h1><p>Đăng nhập để đồng bộ giỏ và đặt hàng.</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]"/><label>Tên đăng nhập<input asp-for="Username" class="form-control" required maxlength="100" autocomplete="username"/></label><label>Mật khẩu<input asp-for="Password" type="password" class="form-control" required maxlength="128" autocomplete="current-password" value=""/></label><button class="btn btn-primary">Đăng nhập</button></form><p class="mt-3">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p></section>

