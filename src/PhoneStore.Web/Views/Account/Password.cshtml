@model PhoneStore.Web.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="account-page">
    <header class="account-intro">
        <h1>Đổi mật khẩu</h1>
        <p>Sau khi đổi mật khẩu, tài khoản sẽ đăng xuất trên mọi thiết bị. Bạn cần đăng nhập lại.</p>
        <nav class="account-navigation" aria-label="Quản lý tài khoản"><a href="/Account/Profile">Thông tin cá nhân</a><a href="/Account/Password" aria-current="page">Đổi mật khẩu</a><a href="/Orders/Index">Đơn hàng của tôi</a></nav>
    </header>
    <form asp-controller="Account" asp-action="Password" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" role="alert" tabindex="-1"></div>
        <div class="field"><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" value="" autocomplete="current-password" maxlength="128" required  aria-describedby="CurrentPassword-error" aria-invalid="@(ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="CurrentPassword" id="CurrentPassword-error"></span></div>
        <div class="field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" value="" autocomplete="new-password" minlength="10" maxlength="128" aria-describedby="new-password-note new-password-error" required  aria-invalid="@(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "true" : null)" /><small id="new-password-note">@PhoneStore.Web.Models.CustomerPasswordAttribute.Policy</small><span asp-validation-for="NewPassword" id="new-password-error"></span></div>
        <button class="button" type="submit">Đổi mật khẩu</button>
    </form>
</div>
