@model PasswordRequest
@{ViewData["Title"]="Đổi mật khẩu";}
<section class="form-card"><h1>Đổi mật khẩu</h1><p>Sau khi đổi, tất cả phiên đăng nhập cũ sẽ kết thúc.</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label>Mật khẩu hiện tại<input asp-for="CurrentPassword" class="form-control" type="password" required maxlength="128" autocomplete="current-password" value=""/></label><label>Mật khẩu mới<input asp-for="NewPassword" class="form-control" type="password" minlength="10" maxlength="128" required autocomplete="new-password" value=""/></label><button class="btn btn-primary">Đổi mật khẩu</button></form></section>

