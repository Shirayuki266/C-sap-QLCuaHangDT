@model PhoneStore.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký tài khoản"; }
<div class="account-page">
    <header class="account-intro">
        <h1>Tạo tài khoản của bạn</h1>
        <p>Lưu thông tin giao hàng và theo dõi đơn điện thoại trong một tài khoản.</p>
        <p>Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
    </header>
    <form asp-controller="Account" asp-action="Register" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" role="alert" tabindex="-1"></div>
        <p class="form-note">Các trường có dấu * là bắt buộc.</p>
        <div class="field"><label asp-for="Username">Tên đăng nhập *</label><input asp-for="Username" autocomplete="username" maxlength="100" aria-describedby="username-note username-error" required  aria-invalid="@(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "true" : null)" /><small id="username-note">3–100 ký tự Latin, số hoặc _ . @@ -.</small><span asp-validation-for="Username" id="username-error"></span></div>
        <div class="field"><label asp-for="Password">Mật khẩu *</label><input asp-for="Password" type="password" value="" autocomplete="new-password" minlength="10" maxlength="128" aria-describedby="password-note password-error" required  aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : null)" /><small id="password-note">@PhoneStore.Web.Models.CustomerPasswordAttribute.Policy</small><span asp-validation-for="Password" id="password-error"></span></div>
        <div class="field"><label asp-for="FullName">Họ tên *</label><input asp-for="FullName" autocomplete="name" maxlength="120" required  aria-describedby="FullName-error" aria-invalid="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="FullName" id="FullName-error"></span></div>
        <div class="field"><label asp-for="Phone">Số điện thoại *</label><input asp-for="Phone" type="tel" autocomplete="tel" maxlength="20" required  aria-describedby="Phone-error" aria-invalid="@(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Phone" id="Phone-error"></span></div>
        <div class="field"><label asp-for="Email">Email <span class="optional">(tùy chọn)</span></label><input asp-for="Email" type="email" autocomplete="email" maxlength="254"  aria-describedby="Email-error" aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Email" id="Email-error"></span></div>
        <div class="field"><label asp-for="Address">Địa chỉ <span class="optional">(tùy chọn)</span></label><input asp-for="Address" autocomplete="street-address" maxlength="500"  aria-describedby="Address-error" aria-invalid="@(ViewData.ModelState["Address"]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Address" id="Address-error"></span></div>
        <button class="button" type="submit">Tạo tài khoản</button>
        <p class="form-note">Sau khi đăng ký, bạn sẽ đăng nhập bằng tài khoản vừa tạo.</p>
    </form>
</div>
