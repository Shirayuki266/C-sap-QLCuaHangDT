@model RegisterRequest
@{ViewData["Title"]="Đăng ký";}
<section class="form-card"><h1>Tạo tài khoản</h1><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label>Tên đăng nhập<input asp-for="Username" class="form-control" required minlength="3" maxlength="100" autocomplete="username"/></label><label>Họ tên<input asp-for="FullName" class="form-control" required maxlength="120" autocomplete="name"/></label><label>Điện thoại<input asp-for="Phone" class="form-control" required maxlength="20" type="tel" autocomplete="tel"/></label><label>Email (tùy chọn)<input asp-for="Email" class="form-control" type="email" maxlength="254" autocomplete="email"/></label><label>Địa chỉ mặc định<input asp-for="Address" class="form-control" maxlength="500" autocomplete="street-address"/></label><label>Mật khẩu<input asp-for="Password" class="form-control" type="password" required minlength="10" maxlength="128" autocomplete="new-password" value=""/><small>Ít nhất 10 ký tự, gồm chữ và số.</small></label><button class="btn btn-primary">Đăng ký</button></form></section>

