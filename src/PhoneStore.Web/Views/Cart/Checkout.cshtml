@model CheckoutModel
@{ViewData["Title"]="Đặt hàng COD";}
<h1>Đặt hàng COD</h1><form method="post" class="checkout-layout"><section class="product"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="RequestKey" type="hidden"/>
<label>Người nhận<input asp-for="Recipient" class="form-control" required maxlength="120" autocomplete="name"/></label><label>Số điện thoại<input asp-for="Phone" class="form-control" type="tel" required maxlength="20" autocomplete="tel"/></label><label>Địa chỉ nhận hàng<textarea asp-for="Address" class="form-control" required minlength="10" maxlength="500" autocomplete="street-address"></textarea></label><fieldset class="payment-options"><legend>Phương thức thanh toán</legend><label><input type="radio" name="PaymentMethod" value="COD" checked/> Thanh toán khi nhận hàng (COD)</label><label class="payment-coming"><input type="radio" value="QR" disabled/> Thanh toán QR — Sắp ra mắt</label><p>QR chưa được hỗ trợ. Vui lòng chọn COD; không chuyển khoản trước.</p></fieldset><p>Vui lòng kiểm tra giá và số lượng trước khi xác nhận.</p></section><aside class="product"><h2>Đơn hàng của bạn</h2>@foreach(var line in Model.Cart.Lines){<p>@line.Name · @line.Color · @line.StorageGb GB × @line.Quantity<br/><strong>@line.Total.FormatMoney() ₫</strong></p>}@for(int i=0;i<Model.Lines.Count;i++){<input asp-for="Lines[i].VariantId" type="hidden"/><input asp-for="Lines[i].Quantity" type="hidden"/><input type="hidden" name="Lines[@i].Price" value="@Model.Lines[i].Price.ToString(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))"/>}<hr/><h2>Tổng: @Model.Cart.Total.FormatMoney() ₫</h2><button class="btn btn-primary" disabled="@(Model.Cart.Lines.Count==0)">Xác nhận đặt hàng</button></aside></form>


