@model PhoneStore.Web.Models.CheckoutViewModel
@{ ViewData["Title"] = "Đặt hàng COD"; }
<div class="cart-heading"><h1>Đặt hàng COD</h1><a href="/Cart/Index">Quay lại giỏ hàng</a></div>
<form action="/Cart/Checkout" method="post" asp-antiforgery="false" class="checkout-form">
    @Html.AntiForgeryToken()
    <input asp-for="RequestKey" type="hidden" />
    <input asp-for="Confirmation" type="hidden" />
    <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
    <div class="checkout-layout">
        <fieldset class="shipping-panel">
            <legend>Thông tin giao hàng</legend>
            <div class="shipping-fields">
                <div><label asp-for="Recipient">Họ tên người nhận <span aria-hidden="true">*</span></label><input asp-for="Recipient" autocomplete="shipping name" maxlength="120" required /><span asp-validation-for="Recipient"></span></div>
                <div><label asp-for="Phone">Số điện thoại <span aria-hidden="true">*</span></label><input asp-for="Phone" type="tel" autocomplete="shipping tel" maxlength="16" required /><span asp-validation-for="Phone"></span></div>
                <div class="shipping-address"><label asp-for="Address">Địa chỉ nhận hàng <span aria-hidden="true">*</span></label><textarea asp-for="Address" autocomplete="shipping street-address" maxlength="500" rows="3" required aria-describedby="address-help"></textarea><span asp-validation-for="Address"></span><p id="address-help">Ghi rõ số nhà, đường, phường/xã và tỉnh/thành phố.</p></div>
            </div>
            <div class="cod-choice"><label><input type="radio" name="PaymentMethod" value="COD" checked required /> Thanh toán khi nhận hàng (COD)</label><p>Bạn thanh toán khi nhận được điện thoại.</p><span asp-validation-for="PaymentMethod"></span></div>
        </fieldset>
        <aside class="checkout-summary" aria-label="Tóm tắt đơn hàng">
            <h2>@(Model.PriceChanged ? "Kiểm tra giá mới" : "Tóm tắt đơn hàng")</h2>
            @if (Model.Cart.Lines.Count == 0)
            { <p>Giỏ hàng đang rỗng. <a href="/Cart/Index">Quay lại giỏ hàng</a> để chọn sản phẩm.</p> }
            @foreach (var line in Model.Cart.Lines)
            {
                <div class="checkout-line" data-variant-id="@line.VariantId">
                    <h3>@(line.Name ?? "Sản phẩm không còn tồn tại") × @line.Quantity</h3>
                    <p>@line.StorageGb GB · @line.Color</p>
                    <p>Đơn giá: @(line.Price.HasValue ? WebsiteFormatting.Money(line.Price.Value) : "Chưa có giá") · Khả dụng: @line.Available</p>
                    <strong>@WebsiteFormatting.Money((line.Price ?? 0) * line.Quantity)</strong>
                    @if (line.Issue is not null)
                    { <p class="cart-line-issue">@(line.Issue == "OUT_OF_STOCK" ? "Thiếu hàng. Vui lòng giảm số lượng trong giỏ." : "Sản phẩm không còn bán. Vui lòng xóa dòng này trong giỏ.")</p> }
                </div>
            }
            <div class="cart-total"><span>Tổng tiền hàng</span><strong id="checkout-total">@WebsiteFormatting.Money(Model.Cart.Total)</strong></div>
            <p>Thanh toán: COD</p>
        </aside>
        <div class="checkout-submit">
            <p>@(Model.PriceChanged ? "Chưa tạo đơn và chưa giữ hàng. Hãy kiểm tra giá mới trước khi xác nhận lại." : "Giá và khả dụng sẽ được kiểm tra lại khi đặt. Nếu có thay đổi, bạn sẽ được yêu cầu xác nhận lại.")</p>
            <button class="button button-primary" type="submit" disabled="@(Model.Cart.Lines.Count == 0 || Model.Cart.HasIssues)">@(Model.PriceChanged ? "Xác nhận giá mới và đặt hàng COD" : "Đặt hàng COD") · @WebsiteFormatting.Money(Model.Cart.Total)</button>
        </div>
    </div>
</form>
