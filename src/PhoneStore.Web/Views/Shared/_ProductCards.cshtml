@model List<ProductDto>
<div class="products">@foreach(var p in Model){var variants=p.Variants.Where(v=>v.Active).ToList();if(variants.Count==0){continue;}<article class="product"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id"><img class="product-image" src="@(string.IsNullOrWhiteSpace(p.ImageUrl)?"/images/phone.svg":p.ImageUrl)" alt="@p.Name" loading="lazy" data-image-fallback="true"/></a><small>@p.Brand · @p.Category</small><h2>@p.Name</h2><p class="specs">@p.Specifications</p><strong>Từ @variants.Min(v=>v.Price).FormatMoney() ₫</strong><p>@(variants.Any(v=>v.Available>0)?"Còn hàng":"Hết hàng")</p><a class="btn btn-outline-primary" asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id">Xem chi tiết</a></article>}</div>
