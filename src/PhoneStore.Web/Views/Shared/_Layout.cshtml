@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken"/><title>@ViewData["Title"] · Phone Store</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body data-customer="@(User.IsInRole("CUSTOMER") ? "true" : "false")"><header><nav class="container site-nav"><a asp-controller="Home" asp-action="Index" class="brand">PHONE STORE</a><div class="nav-pages"><a asp-controller="Home" asp-action="Index">Trang chủ</a><a asp-controller="Catalog" asp-action="Index">Sản phẩm</a></div><form action="/Search" method="get" class="header-search" role="search" autocomplete="off"><label class="visually-hidden" for="header-query">Tìm điện thoại</label><div class="search-input"><input id="header-query" name="Query" maxlength="100" value="@Context.Request.Query["Query"]" placeholder="Bạn đang tìm điện thoại nào?" role="combobox" aria-autocomplete="list" aria-controls="search-suggestions" aria-expanded="false"/><button aria-label="Tìm kiếm" type="submit">Tìm</button></div><div id="search-suggestions" role="listbox" hidden></div><span id="search-status" class="visually-hidden" role="status" aria-live="polite"></span></form><div class="nav-links"><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>@if(User.Identity?.IsAuthenticated==true){<details class="account-menu"><summary>Tài khoản</summary><div><a asp-controller="Account" asp-action="Profile">Hồ sơ</a><a asp-controller="Orders" asp-action="Index">Đơn hàng</a><a asp-controller="Account" asp-action="Password">Đổi mật khẩu</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm">Đăng xuất</button></form></div></details>}else{<a asp-controller="Account" asp-action="Login">Đăng nhập</a>}</div></nav></header>
<main class="container py-4"><div id="guest-notice" role="status" aria-live="polite"></div>@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main><footer class="container py-4">Phone Store · Thanh toán khi nhận hàng (COD) · <a href="/Home/ImageCredits">Nguồn ảnh</a></footer><script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/discovery.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
